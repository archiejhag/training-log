# Copy to .env.local and fill in from your Supabase project
# (Project Settings → API). Both are safe to expose in a client bundle —
# the anon key only works through Row Level Security.
#
# Leave these unset and the app runs exactly as before: local-only,
# no account, no sync.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
